<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RequirementsGenerator.Server</RootNamespace>
    <UserSecretsId>rag-requirements-generator</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure.AI.OpenAI is the current Microsoft Foundry / Azure OpenAI client for .NET; it wraps the
         official OpenAI SDK types (ChatClient, ChatMessage, etc.) with Azure auth support. -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
  </ItemGroup>

  <!--
    Builds the React/TypeScript client (src/client) and emits its production bundle directly into
    wwwroot/ so a single `dotnet publish` produces one deployable artifact for App Service.
    See src/client/vite.config.ts for the matching outDir.
  -->
  <Target Name="BuildClient" BeforeTargets="Publish">
    <Exec Command="npm ci" WorkingDirectory="../client" Condition="!Exists('../client/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="../client" />
  </Target>

</Project>
