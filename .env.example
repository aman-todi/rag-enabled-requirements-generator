# Copy this file to .env for local development (`.env` is gitignored — never commit real values).
#
# In Azure, these are NOT read from a .env file. They are set as App Service "Application
# settings", which App Service injects as process environment variables at startup. ASP.NET
# Core's configuration system maps the double-underscore names below onto the nested "Foundry"
# options section (Foundry__Endpoint -> Foundry:Endpoint). See README.md "Configuration".

# --- Microsoft Foundry model deployment -------------------------------------------------------

# Base endpoint of the Foundry resource/project hosting the chat model deployment that is
# already wired to the internal requirements-writing guide via Azure AI Search (RAG).
# Example: https://my-foundry-resource.services.ai.azure.com/
Foundry__Endpoint=

# Name of the chat model deployment to call (not the base model name), e.g. gpt-4o or an
# agent/deployment alias defined in your Foundry project.
Foundry__DeploymentName=

# Optional: client ID of a user-assigned managed identity. Leave blank to use the App Service's
# system-assigned managed identity (recommended default — see README.md "Managed Identity").
Foundry__ClientId=

# Optional, LOCAL DEV ONLY: an API key, used only if you cannot run `az login` locally with an
# account that has the "Foundry User" role on the resource. Never set this in Azure App Service —
# production auth must be keyless via managed identity + DefaultAzureCredential.
Foundry__ApiKey=

# Optional: overrides/reinforces the system prompt. The primary grounding instructions (the
# internal requirements-writing guide + examples) live in the Azure AI Search index attached to
# the Foundry deployment/agent, not here.
Foundry__SystemPrompt=

# --- ASP.NET Core host --------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Development

# --- React client (src/client), used only by `npm run dev` -------------------------------------

# Where the Vite dev server proxies /api requests to. Matches src/Server/Properties/launchSettings.json.
VITE_API_PROXY_TARGET=http://localhost:5080
